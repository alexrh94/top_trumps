{
  "name": "top-trumps",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:client",
    "build:client": "tsc -p client --noEmit && vite build --config client/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p client --noEmit && tsc -p server --noEmit",
    "test": "tsx --test server/src/roomCode.test.ts server/src/deck.test.ts server/src/rooms.test.ts server/src/game.test.ts server/src/static.test.ts server/src/server.test.ts"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
